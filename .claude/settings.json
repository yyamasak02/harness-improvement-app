      "Bash(wails *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(make *)",
      "Bash(bash scripts/*)",
      "Bash(sh scripts/*)",
      "Bash(./scripts/*)",
      "Bash(chmod +x scripts/*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git checkout main)",
