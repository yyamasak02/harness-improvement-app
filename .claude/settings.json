      "Bash(git remote -v)",
      "Bash(git rm *)",
      "Bash(git mv *)",
      "Bash(git restore *)",
      "Bash(git stash*)",
      "Bash(gh pr create*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr status*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(gh run watch*)",
      "Bash(gh repo view*)",
      "Bash(gh auth status*)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(rm *)",
      "Bash(touch *)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(wc *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(sort *)",
      "Bash(diff *)",
      "Bash(which *)",
      "Bash(hdiutil *)",
      "Read(~/.claude/projects/**)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:wails.io)",
      "WebFetch(domain:pkg.go.dev)",
      "Bash(gh issue create*)",
      "Bash(gh issue list*)",
      "Bash(gh issue view*)",
      "Bash(gh issue edit*)",
      "Bash(gh issue comment*)",
      "Bash(gh issue close*)",
      "Bash(gh label create*)",
      "Bash(gh label list*)",
      "Bash(gh label edit*)",
      "Bash(gh workflow list*)",
      "Bash(gh workflow view*)",
      "Bash(pre-commit *)",
      "Bash(staticcheck *)",
      "Bash(git tag -l*)",
      "Bash(git tag -a *)",
      "Bash(git tag --list*)",
      "Bash(gh pr comment*)",
      "Bash(gh pr review*)",
      "Bash(gh pr ready*)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(sudo *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push --delete*)",
      "Bash(git push * --delete*)",
      "Bash(git push * :*)",
      "Bash(git push --tags*)",
      "Bash(git push * v*)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git config *)",
      "Bash(gh repo delete*)",
      "Bash(gh release *)",
      "Bash(gh secret *)",
      "Bash(gh auth *)",
      "Bash(gh api *)",
      "Edit(~/.claude/**)",
      "Write(~/.claude/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Bash(git commit*--no-verify*)",
      "Bash(git commit* -n *)",
      "Bash(git push*--no-verify*)",
      "Bash(pre-commit uninstall*)",
      "Bash(gh pr merge*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/status.sh --brief 2>/dev/null || true",
            "timeout": 60
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '【規則】ユーザーの要求（機能追加・修正・方針変更・調査の依頼）は、実装に入る前に必ず GitHub issue にする（create-issue skill、ラベルは .claude/rules/issues-labels.md）。複数の依頼は 1 件ずつ別 issue。起票した番号を返信で伝え、PR 本文で Closes/Refs #N する。質問への回答のみなら不要。'"
          }
        ]
      }
    ]
  }
}
