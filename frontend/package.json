{
  "name": "frontend",
  "private": true,
  "version": "0.1.0-rc.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview",
    "e2e": "npm run build && playwright test",
    "e2e:ux": "npm run build && node e2e/summarize-ux.mjs --clean && (playwright test -c playwright.ux.config.ts; s=$?; node e2e/summarize-ux.mjs; r=$?; [ $s -eq 0 ] && [ $r -eq 0 ])"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.12",
    "autoprefixer": "^10.6.2",
    "jsdom": "^31.0.1",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^7.0.0",
    "vitest": "^4.1.12"
  }
}
